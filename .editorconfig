# EditorConfig keeps files identical on macOS, Windows and Linux.
# Without it, a Windows editor can save CRLF line endings, and the
# "Build Explorer" CI job — which requires a byte-identical bundle —
# fails for a reason that has nothing to do with your change.
# See also .gitattributes, which enforces the same thing inside git.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown uses two trailing spaces for a hard line break, so trimming
# them would silently change how the docs render.
[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab
